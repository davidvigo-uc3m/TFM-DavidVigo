<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://www.uc3m.es/tfm/consultasaldo"
           targetNamespace="http://www.uc3m.es/tfm/consultasaldo"
           elementFormDefault="qualified">

    <!-- Petición: Datos de entrada -->
    <xs:element name="ConsultaSaldoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroCuenta" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Respuesta: Datos de salida -->
    <xs:element name="ConsultaSaldoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="saldo" type="xs:decimal"/>
                <xs:element name="divisa" type="xs:string"/>
                <xs:element name="estado" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>